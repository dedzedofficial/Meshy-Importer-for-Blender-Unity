<!--
  Type-checks the Unity package without a Unity install: real UnityEngine reference
  assemblies (NuGet UnityEngine.Modules) plus a thin stub of the UnityEditor APIs the
  package uses (UnityEditorStubs.cs). C# 8 = the language level of Unity 2020.3.
    dotnet build tests/csharp/unity-compile
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <DefineConstants>UNITY_EDITOR;UNITY_2020_2_OR_NEWER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0414;CS0649;CS0169;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Editor/*.cs" />
    <Compile Include="../../../unity/Runtime/*.cs" />
    <Compile Include="UnityEditorStubs.cs" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
