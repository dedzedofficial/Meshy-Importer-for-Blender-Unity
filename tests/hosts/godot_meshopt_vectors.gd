extends SceneTree
## meshoptimizer's own test vectors (demo/tests.cpp) through meshy_meshopt.gd.

func _init() -> void:
	var M = load("res://addons/meshy_importer/meshy_meshopt.gd")
	var ok := true
	var idx0 := PackedByteArray([0xe0, 0xf0, 0x10, 0xfe, 0xff, 0xf0, 0x0c, 0xff, 0x02, 0x02, 0x02, 0x00, 0x76, 0x87, 0x56, 0x67, 0x78, 0xa9, 0x86, 0x65, 0x89, 0x68, 0x98, 0x01, 0x69, 0x00, 0x00])
	ok = _check("index v0", Array(M.decode_index_buffer(idx0, 12)), [0, 1, 2, 2, 1, 3, 4, 6, 5, 7, 8, 9]) and ok
	var idx1 := PackedByteArray([0xe1, 0xf0, 0x10, 0xfe, 0x1f, 0x3d, 0x00, 0x0a, 0x00, 0x76, 0x87, 0x56, 0x67, 0x78, 0xa9, 0x86, 0x65, 0x89, 0x68, 0x98, 0x01, 0x69, 0x00, 0x00])
	ok = _check("index v1", Array(M.decode_index_buffer(idx1, 15)), [0, 1, 2, 2, 1, 3, 0, 1, 2, 2, 1, 5, 2, 1, 4]) and ok
	var seq := PackedByteArray([0xd1, 0x00, 0x04, 0xcd, 0x01, 0x04, 0x07, 0x98, 0x1f, 0x00, 0x00, 0x00, 0x00])
	ok = _check("sequence", Array(M.decode_index_sequence(seq, 6)), [0, 1, 51, 2, 49, 1000]) and ok
	var v0 := PackedByteArray([0xa0, 0x01, 0x3f, 0x00, 0x00, 0x00, 0x58, 0x57, 0x58, 0x01, 0x26, 0x00, 0x00, 0x00, 0x01, 0x0c, 0x00, 0x00, 0x00, 0x58, 0x01, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x3f, 0x00, 0x00, 0x00, 0x17, 0x18, 0x17, 0x01, 0x26, 0x00, 0x00, 0x00, 0x01, 0x0c, 0x00, 0x00, 0x00, 0x17, 0x01, 0x08])
	var pad := PackedByteArray()
	pad.resize(35)
	v0.append_array(pad)
	var out: PackedByteArray = M.decode_vertex_buffer(v0, 4, 12)
	var rows := []
	for i in 4:
		rows.append([out.decode_u16(i * 12), out.decode_u16(i * 12 + 2), out.decode_u16(i * 12 + 8), out.decode_u16(i * 12 + 10)])
	ok = _check("vertex v0", rows, [[0, 0, 0, 0], [300, 0, 500, 0], [0, 300, 0, 500], [300, 300, 500, 500]]) and ok
	var oct := PackedByteArray([0, 1, 127, 0, 0, 187, 127, 1, 255, 1, 127, 0, 14, 130, 127, 1])
	M.decode_filter_oct(oct, 4, 4)
	ok = _check("oct8", Array(oct), [0, 1, 127, 0, 0, 159, 82, 1, 255, 1, 127, 0, 1, 130, 241, 1]) and ok
	print("GDSCRIPT MESHOPT VECTORS " + ("PASSED" if ok else "FAILED"))
	quit(0 if ok else 1)


func _check(name: String, got: Array, want: Array) -> bool:
	if got != want:
		print("FAIL %s: got %s want %s" % [name, got, want])
		return false
	return true
